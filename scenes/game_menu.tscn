[gd_scene label="res://scenes/game_menu.tscn"]

[node name="GameMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/padding_left = 16
theme_override_constants/padding_right = 16
theme_override_constants/padding_top = 16
theme_override_constants/padding_bottom = 16

[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="ShadowPanel" type="Panel" parent="CanvasLayer"]
anchor_right = 1.0
anchor_bottom = 1.0
size_flags_horizontal = 3
size_flags_vertical = 3
modulate = Color(0, 0, 0, 0.4)
__meta__ = {
"_edit_use_anchors_" = false
}

[node name="MenuPanel" type="PanelContainer" parent="CanvasLayer/ShadowPanel"]
custom_minimum_size = Vector2( 560, 560 )
anchor_right = 1.0
anchor_bottom = 1.0
pos_min = Vector2( -280, -280 )
pos_max = Vector2( 280, 280 )
size_flags_horizontal = 1
size_flags_vertical = 1
__meta__ = {
"_edit_use_anchors_" = false
}

[node name="MarginContainer" type="MarginContainer" parent="CanvasLayer/ShadowPanel/MenuPanel"]
margin_right = 520.0
margin_bottom = 488.0
custom_minimum_size = Vector2( 128, 128 )
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="TitleLabel" type="Label" parent="CanvasLayer/ShadowPanel/MenuPanel/MarginContainer"]
modulate = Color(1, 1, 1, 0.9)
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -140.0
offset_top = -42.0
offset_right = 140.0
offset_bottom = 42.0
grow_horizontal = 2
grow_vertical = 2
text = "REALWORLD\nSURVIVAL 3D"
align = 1
theme_override_colors/font_color = Color(1, 1, 1, 1)
__meta__ = {
"_edit_use_anchors_" = false
}

[node name="CreditsLabel" type="Label" parent="CanvasLayer/ShadowPanel/MenuPanel/MarginContainer"]
modulate = Color(0.9, 0.9, 0.9, 0.7)
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -140.0
offset_top = 56.0
offset_right = 140.0
offset_bottom = 102.0
